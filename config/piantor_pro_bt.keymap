#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&mt {
    flavor = "tap-preferred";
    tapping-term-ms = <200>;
};

/ {
    chosen {
        zmk,physical-layout = &default_layout; };

    macros {
        ae: ae {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp DOUBLE_QUOTES &kp A>;
            label = "AE";
        };

        oe: oe {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp DOUBLE_QUOTES &kp O>;
            label = "OE";
        };

        ue: ue {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp DOUBLE_QUOTES &kp U>;
            label = "UE";
        };
    };

    combos {
        compatible = "zmk,combos";

        semicolon {
            bindings = <&kp SEMI>;
            key-positions = <33 32>;
        };
    };

    behaviors {
        oe_rctrl: oe_rctrl {
            compatible = "zmk,behavior-hold-tap";
            label = "OE_RCTRL";
            bindings = <&kp>, <&oe>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            hold-while-undecided;
            hold-trigger-key-positions = <0 1 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 2 3 4 5>;
            hold-trigger-on-release;
        };

        slash_qm_em: slash_qm_em {
            compatible = "zmk,behavior-tap-dance";
            label = "SLASH_QM_EM";
            #binding-cells = <0>;
            bindings = <&kp SLASH>, <&kp QUESTION>, <&kp EXCL>;
        };

        lt8_slash: lt8_slash {
            compatible = "zmk,behavior-hold-tap";
            label = "LT8_SLASH";
            bindings = <&lt>, <&slash_qm_em>;

            #binding-cells = <2>;
            hold-while-undecided;
            hold-trigger-on-release;
            hold-trigger-key-positions = <0 1 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 2 3 4 5>;
            tapping-term-ms = <200>;
        };

        dot_colon: dot_colon {
            compatible = "zmk,behavior-tap-dance";
            label = "DOT_COLON";
            #binding-cells = <0>;
            bindings = <&kp DOT>, <&kp COLON>;
        };

        comma_dquote: comma_dquote {
            compatible = "zmk,behavior-tap-dance";
            label = "COMMA_DQUOTE";
            #binding-cells = <0>;
            bindings = <&kp COMMA>, <&kp DOUBLE_QUOTES>;
        };
    };
};

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "QWERTY";

            //---------------------------------------------------------------------------------
            //| LG+TAB | Q | W | E | R | T | Z | U | I | O | P | UE |
            //| LG+` | A/CTRL | S/ALT | D/GUI | F/SHIFT | G | H | J/RSHIFT | K/RGUI | L/RALT | 0/RCTRL | AE |
            //| SL9 | Y/LT7 | X | C | V | B | N | M | ,/\" | ./: | /?/! | SL9 |
            //| DEL/LT3 | BSPC/LT1 | ESC/LT2 | RET/LT5 | SPC/LT4 | TAB/LT6 |

            bindings = <
                &kp LG(TAB)       &kp Q       &kp W       &kp E       &kp R       &kp T       &kp Z       &kp U       &kp I       &kp O       &kp P       &ue
                &kp LG(GRAVE)     &mt LEFT_CONTROL A  &mt LALT S  &mt LEFT_GUI D  &mt LSHFT F  &kp G       &kp H       &mt RSHFT J  &mt RIGHT_GUI K  &mt RALT L  &oe_rctrl RIGHT_CONTROL 0  &ae
                &sl 9             &lt 7 Y     &kp X     &kp C     &kp V     &kp B     &kp N     &kp M     &comma_dquote  &dot_colon  &lt8_slash 7 0  &sl 9
                                 &lt 3 DELETE &lt 1 BACKSPACE &lt 2 ESC &lt 5 RET &lt 4 SPACE &lt 6 TAB
            >;
        };

        nav_layer {
            display-name = "NAV";

            //-----------------------------------------------------------------------------------
            //|      |     |     |     |     |     | REDO | PASTE | COPY | CUT | UNDO |      |
            //|      | CTRL | ALT | GUI | SHIFT |     | LEFT | DOWN | UP | RIGHT |     |      |
            //|      |     |     |     |     |     | TOG MOUSE |     | RG+LEFT | PGDN | PGUP | RG+RIGHT |
            //| TRANS | TRANS | TRANS | ENTER | SPACE | TAB |

            bindings = <
                &none            &none       &none       &none       &none       &none       &kp RS(RG(Z)) &kp RG(V) &kp RG(C) &kp RG(X) &kp RG(Z) &none
                &none            &kp LEFT_CONTROL &kp LALT &kp LEFT_GUI &kp LSHFT &none &kp LEFT_ARROW &kp DOWN_ARROW &kp UP_ARROW &kp RIGHT &none &none
                &none            &none       &none       &none       &none       &none       &tog 1     &none       &kp RG(LEFT) &kp PAGE_DOWN &kp PAGE_UP &kp RG(RIGHT)
                                 &trans           &trans     &trans     &kp ENTER  &kp SPACE  &kp TAB
            >;
        };

        mouse_layer {
            display-name = "MOUSE";
            //-----------------------------------------------------------------------------------
            //|      |     |     |     |     |     | REDO | PASTE | COPY | CUT | UNDO |      |
            //|      | CTRL | ALT | GUI | SHIFT |     | MOVE LEFT | MOVE DOWN | MOVE UP | MOVE RIGHT |     |      |
            //|      |     |     |     |     |     | TOG MOUSE |     | SCROLL LEFT | SCROLL DOWN | SCROLL UP | SCROLL RIGHT |
            //| TRANS | TRANS | TRANS | RCLICK | LCLICK | MCLICK |
            bindings = <
                &none            &none       &none       &none       &none       &none       &kp RG(RS(Z)) &kp RG(V) &kp RG(C) &kp RG(X) &kp RG(Z) &none
                &none            &kp LEFT_CONTROL &kp LEFT_ALT &kp LEFT_GUI &kp LEFT_SHIFT &none &mmv MOVE_LEFT &mmv MOVE_DOWN &mmv MOVE_UP &mmv MOVE_RIGHT &none &none
                &none            &none       &none       &none       &none       &none       &tog 2     &none       &msc SCRL_LEFT &msc SCRL_DOWN &msc SCRL_UP &msc SCRL_RIGHT
                                 &trans           &trans     &trans     &mkp RCLK  &mkp LCLK  &mkp MCLK
            >;
        };

        media_layer {
            display-name = "MEDIA";

            //-----------------------------------------------------------------------------
            //|      |     |     |     |     | RGB TOG | HUD | HUI | SAD | SAI | BRD | BRI |
            //|      | CTRL | ALT | GUI | SHIFT | EFFECT | PREV | VOL- | VOL+ | NEXT | SPD | SPI |
            //|      | RESET | BOOT | UNLOCK | TOG NUM |     | BT CLR | BT1 | BT2 | BT3 | BT4 | BT5 |
            //| TRANS | TRANS | TRANS | STOP | PLAY/PAUSE | MUTE |

            bindings = <
                &none            &none       &none       &none       &none       &rgb_ug RGB_TOG &rgb_ug RGB_HUD &rgb_ug RGB_HUI &rgb_ug RGB_SAD &rgb_ug RGB_SAI &rgb_ug RGB_BRD &rgb_ug RGB_BRI
                &none            &kp LEFT_CONTROL &kp LEFT_ALT &kp LGUI &kp LSHIFT &rgb_ug RGB_EFF &kp C_PREV &kp C_VOL_DN &kp C_VOLUME_UP &kp C_NEXT &rgb_ug RGB_SPD &rgb_ug RGB_SPI
                &none            &sys_reset  &bootloader &studio_unlock &tog 3 &none &bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4
                                 &trans           &trans     &trans     &kp C_STOP &kp C_PLAY_PAUSE &kp C_MUTE
            >;
        };

        num_layer {
            display-name = "NUM";

            //----------------------------------------------------------------------------
            //| TRANS | [ | 7 | 8 | 9 | ] |     |     |     |     |     | TRANS |
            //| TRANS | ; | 4 | 5 | 6 | = |     | RSHIFT | RGUI | RALT | RCTRL | TRANS |
            //| TRANS | ` | 1 | 2 | 3 | \ |     | TOG SYM |     |     |     | TRANS |
            //| . | 0 | - | TRANS | TRANS | TRANS |

            bindings = <
                &trans           &kp LBKT   &kp N7      &kp N8      &kp N9      &kp RBKT   &none       &none       &none       &none       &none       &trans
                &trans           &kp SEMI   &kp N4      &kp N5      &kp N6      &kp EQUAL  &none       &kp RSHFT   &kp RIGHT_GUI &kp RALT   &kp RIGHT_CONTROL &trans
                &trans           &kp GRAVE  &kp N1      &kp N2      &kp N3      &kp BSLH   &none       &tog 4      &none       &none       &none       &trans
                                 &kp DOT    &kp N0      &kp MINUS   &trans      &trans      &trans
            >;
        };

        sym_layer {
            display-name = "SYM";

            //-----------------------------------------------------------------------------
            //| TRANS | { | & | * | ( | } |     |     |     |     |     | TRANS |
            //| TRANS | : | $ | % | ^ | + |     | RSHIFT | RGUI | RALT | RCTRL | TRANS |
            //| TRANS | ~ | ! | @ | # | | |     | TOG FUN |     |     |     | TRANS |
            //| ( | ) | _ | TRANS | TRANS | TRANS |

            bindings = <
                &trans           &kp LBRC   &kp AMPS    &kp ASTRK   &kp LPAR    &kp RBRC   &none       &none       &none       &none       &none       &trans
                &trans           &kp COLON  &kp DLLR    &kp PRCNT   &kp CARET   &kp PLUS   &none       &kp RSHFT   &kp RIGHT_GUI &kp RALT   &kp RIGHT_CONTROL &trans
                &trans           &kp TILDE  &kp EXCL    &kp AT      &kp HASH    &kp PIPE   &none       &tog 5      &none       &none       &none       &trans
                                 &kp LPAR   &kp RPAR    &kp UNDER   &trans      &trans      &trans
            >;
        };

        fun_layer {
            display-name = "FUN";

            //------------------------------------------------------------------------------
            //| TRANS | F12 | F7 | F8 | F9 | SCREENSHOT |     |     |     |     |     | TRANS |
            //| TRANS | F11 | F4 | F5 | F6 | SCROLL LOCK |     | RSHIFT | RGUI | RALT | RCTRL | TRANS |
            //| TRANS | F10 | F1 | F2 | F3 | PAUSE |     | TOG ADJUST |     |     |     | TRANS |
            //| DEL | BSPC | ESC | TRANS | TRANS | TRANS |

            bindings = <
                &trans           &kp F12    &kp F7      &kp F8      &kp F9      &kp LS(LG(NUMBER_4)) &none       &none       &none       &none       &none       &trans
                &trans           &kp F11    &kp F4      &kp F5      &kp F6      &kp SLCK   &none       &kp RIGHT_SHIFT &kp RIGHT_GUI &kp RIGHT_ALT &kp RIGHT_CONTROL &trans
                &trans           &kp F10    &kp F1      &kp F2      &kp F3      &kp PAUSE_BREAK &none    &tog 6      &none       &none       &none       &trans
                                 &kp DEL    &kp BACKSPACE &kp ESC    &trans      &trans      &trans
            >;
        };

        button_layer {
            display-name = "BUTTON";

            //-------------------------------------------------------------------------
            //|      | HUD | HUI | SAD | SAI | EFFECT | EFFECT | SAI | SAD | HUI | HUD |      |
            //|      | PREV | VOL- | MUTE | VOL+ | NEXT | PREV | VOL- | MUTE | VOL+ | NEXT |      |
            //|      | BRI | BRD | RGB TOG |     |     |     |     | RGB TOG | BRD | BRI |      |
            //| TRANS | TRANS | TRANS | TRANS | TRANS | TRANS |

            bindings = <
                &none            &rgb_ug RGB_HUD &rgb_ug RGB_HUI &rgb_ug RGB_SAD &rgb_ug RGB_SAI &rgb_ug RGB_EFF &rgb_ug RGB_EFF &rgb_ug RGB_SAI &rgb_ug RGB_SAD &rgb_ug RGB_HUI &rgb_ug RGB_HUD &none
                &none            &kp C_PREV  &kp C_VOL_DN &kp C_MUTE &kp C_VOL_UP &kp C_NEXT &kp C_PREV &kp C_VOL_DN &kp C_MUTE &kp C_VOL_UP &kp C_NEXT &none
                &none            &rgb_ug RGB_BRI &rgb_ug RGB_BRD &rgb_ug RGB_TOG &none &none &none &none &rgb_ug RGB_TOG &rgb_ug RGB_BRD &rgb_ug RGB_BRI &none
                                 &trans           &trans     &trans     &trans     &trans     &trans
            >;
        };

        shortcut_layer {
            display-name = "shortcut";
            //-------------------------------------------------------------------------
            //|                                      SCREENSHOT                          |
            //|                          (Left Shift + Left GUI + 4)                     |
            bindings = <
                &trans           &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &kp LS(LG(NUMBER_4)) &trans
                &trans           &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans
                &trans           &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans     &trans
                                 &trans     &trans     &trans     &trans     &trans     &trans
            >;
        };
    };
};
