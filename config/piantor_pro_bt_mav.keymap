#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

#define BASE 0
#define NAV 1
#define MEDIA 2
#define NUM 3
#define SYM 4
#define FUN 5
#define ADJUST 6

&mt {
    flavor = "tap-preferred";
    tapping-term-ms = <200>;
};

/ {
    chosen { zmk,physical-layout = &five_col_layout; };

    macros {
        ae: ae {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp DOUBLE_QUOTES &kp A>;
            label = "AE";
        };

        oe: oe {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp DOUBLE_QUOTES &kp O>;
            label = "OE";
        };

        ue: ue {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp DOUBLE_QUOTES &kp U>;
            label = "UE";
        };
    };

    combos {
        compatible = "zmk,combos";

        semicolon {
            bindings = <&kp SEMI>;
            key-positions = <33 32>;
        };
    };

    behaviors {
        oe_rctrl: oe_rctrl {
            compatible = "zmk,behavior-hold-tap";
            label = "OE_RCTRL";
            bindings = <&kp>, <&oe>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            hold-while-undecided;
            hold-trigger-key-positions = <0 1 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 2 3 4 5>;
            hold-trigger-on-release;
        };

        slash_qm_em: slash_qm_em {
            compatible = "zmk,behavior-tap-dance";
            label = "SLASH_QM_EM";
            #binding-cells = <0>;
            bindings = <&kp SLASH>, <&kp QUESTION>, <&kp EXCL>;
        };

        lt8_slash: lt8_slash {
            compatible = "zmk,behavior-hold-tap";
            label = "LT8_SLASH";
            bindings = <&lt>, <&slash_qm_em>;

            #binding-cells = <2>;
            hold-while-undecided;
            hold-trigger-on-release;
            hold-trigger-key-positions = <0 1 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 2 3 4 5>;
            tapping-term-ms = <200>;
        };

        dot_colon: dot_colon {
            compatible = "zmk,behavior-tap-dance";
            label = "DOT_COLON";
            #binding-cells = <0>;
            bindings = <&kp DOT>, <&kp COLON>;
        };

        comma_dquote: comma_dquote {
            compatible = "zmk,behavior-tap-dance";
            label = "COMMA_DQUOTE";
            #binding-cells = <0>;
            bindings = <&kp COMMA>, <&kp DOUBLE_QUOTES>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "QWERTY";

            //---------------------------------------------------------------------------------
            //|  TAB |  Q  |  W  |  E  |  R  |  T  |  Y  |  U  |  I  |  O  |  P  | BSPC |
            //| CTRL | GUI/A | ALT/S | CTRL/D | SHIFT/F | G | H | SHIFT/J | CTRL/K | ALT/L | GUI/; |  '   |
            //| SHFT |  Z  |  X  |  C  |  V  |  B  |  N  |  M  |  ,  |  .  |  /  | ESC  |
            //       | ESC/MEDIA | SPACE/NAV | TAB/FUN | RET/SYM | BSPC/NUM | DEL/ADJ |

            bindings = <
&kp LG(TAB)  &kp Q  &kp W  &kp E  &kp R  &kp T  &kp Z  &kp U  &kp I  &kp O  &kp P  &ue  &kp LG(GRAVE)  &mt LEFT_CONTROL A  &mt LALT S  &mt LEFT_GUI D  &mt LSHFT F  &kp G  &kp H  &mt RSHFT J  &mt RIGHT_GUI K  &mt RALT L  &oe_rctrl RIGHT_CONTROL 0  &ae  &sl 8  &lt 7 Y  &kp X  &kp C  &kp V  &kp B  &kp N  &kp M  &comma_dquote  &dot_colon  &lt8_slash 7 0  &sl 8  &lt 3 DELETE  &lt 1 BACKSPACE  &lt 2 ESC  &lt 5 RET  &lt 4 SPACE  &lt 6 TAB
            >;
        };

        nav_layer {
            display-name = "NAV";

            //-----------------------------------------------------------------------------------
            //|  TAB |     |     |      |       |     |      |      |      |      |      | BSPC |
            //| CTRL | GUI | ALT | CTRL | SHIFT |     | CAPS | LEFT | DOWN |  UP  | RIGHT|      |
            //| SHFT |     |     |      |       |     | INS  | HOME | PGDN | PGUP | END  |      |
            //                  |     |     |     |     |     |     |

            bindings = <
&kp TAB  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &kp BSPC  &kp LCTRL  &kp LGUI  &kp LALT  &kp LCTRL  &kp LSHFT  &none  &kp CAPS  &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &trans  &kp LSHFT  &none  &none  &none  &none  &none  &kp INS  &kp HOME  &kp PG_DN  &kp PG_UP  &kp END  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        mouse_layer {
            display-name = "MOUSE";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &tran  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &tran  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &tran  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        media_layer {
            display-name = "MEDIA";

            //-------------------------------------------------------------------------
            //|      | HUD | HUI | SAD | SAI | EFF | EFF | SAI | SAD | HUI | HUD |    |
            //|      | PREV| VOLD| MUTE| VOLU| NEXT| PREV| VOLD| MUTE| VOLU| NEXT|    |
            //|      | BRI | BRD | TOG |     |     |     |     | TOG | BRD | BRI |    |
            //                  |     |     |     |     |     |     |

            bindings = <
&trans  &rgb_ug RGB_HUD  &rgb_ug RGB_HUI  &rgb_ug RGB_SAD  &rgb_ug RGB_SAI  &rgb_ug RGB_EFF  &rgb_ug RGB_EFF  &rgb_ug RGB_SAI  &rgb_ug RGB_SAD  &rgb_ug RGB_HUI  &rgb_ug RGB_HUD  &trans  &trans  &kp C_PREV  &kp C_VOL_DN  &kp C_MUTE  &kp C_VOL_UP  &kp C_NEXT  &kp C_PREV  &kp C_VOL_DN  &kp C_MUTE  &kp C_VOL_UP  &kp C_NEXT  &trans  &trans  &rgb_ug RGB_BRI  &rgb_ug RGB_BRD  &rgb_ug RGB_TOG  &none  &none  &none  &none  &rgb_ug RGB_TOG  &rgb_ug RGB_BRD  &rgb_ug RGB_BRI  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        num_layer {
            display-name = "NUM";

            //----------------------------------------------------------------------------
            //|      |  [  |  7  |  8  |  9  |  ]  |     |       |      |     |     |    |
            //|      |  ;  |  4  |  5  |  6  |  =  |     | SHIFT | CTRL | ALT | GUI |    |
            //|      |  `  |  1  |  2  |  3  |  \  |     |       |      |     |     |    |
            //                  |  .  |  0  |  -  |     |     |     |

            bindings = <
&trans  &kp LBKT  &kp N7  &kp N8  &kp N9  &kp RBKT  &none  &none  &none  &none  &none  &trans  &trans  &kp SEMI  &kp N4  &kp N5  &kp N6  &kp EQUAL  &none  &kp RSHFT  &kp RCTRL  &kp RALT  &kp RGUI  &trans  &trans  &kp GRAVE  &kp N1  &kp N2  &kp N3  &kp BSLH  &none  &none  &none  &none  &none  &trans  &kp DOT  &kp N0  &kp MINUS  &trans  &trans  &trans
            >;
        };

        sym_layer {
            display-name = "SYM";

            //-----------------------------------------------------------------------------
            //|      |  {  |  &  |  *  |  (  |  }  |     |       |      |     |     |    |
            //|      |  :  |  $  |  %  |  ^  |  +  |     | SHIFT | CTRL | ALT | GUI |    |
            //|      |  ~  |  !  |  @  |  #  |  |  |     |       |      |     |     |    |
            //                  |  (  |  )  |  _  |     |     |     |

            bindings = <
&trans  &kp LBRC  &kp AMPS  &kp ASTRK  &kp LPAR  &kp RBRC  &none  &none  &none  &none  &none  &trans  &trans  &kp COLON  &kp DLLR  &kp PRCNT  &kp CARET  &kp PLUS  &none  &kp RSHFT  &kp RCTRL  &kp RALT  &kp RGUI  &trans  &trans  &kp TILDE  &kp EXCL  &kp AT  &kp HASH  &kp PIPE  &none  &none  &none  &none  &none  &trans  &kp LPAR  &kp RPAR  &kp UNDER  &trans  &trans  &trans
            >;
        };

        fun_layer {
            display-name = "FUN";

            //------------------------------------------------------------------------------
            //|      |     |     |      |       |     | PSCR| F7 | F8 | F9 | F12|    |
            //|      | GUI | ALT | CTRL | SHIFT |     | SLCK| F4 | F5 | F6 | F11|    |
            //|      |     |     |      |       |     | PAUS| F1 | F2 | F3 | F10|    |
            //                        |     |     |     |     |     |     |

            bindings = <
&trans  &none  &none  &none  &none  &none  &kp PSCRN  &kp F7  &kp F8  &kp F9  &kp F12  &trans  &trans  &kp LGUI  &kp LALT  &kp LCTRL  &kp LSHFT  &none  &kp SLCK  &kp F4  &kp F5  &kp F6  &kp F11  &trans  &trans  &none  &none  &none  &none  &none  &kp PAUSE_BREAK  &kp F1  &kp F2  &kp F3  &kp F10  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        adjust_layer {
            display-name = "ADJUST";

            //-----------------------------------------------------------------------------
            //|      | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |     |     |     |     |   |
            //|      | HUD | HUI | SAD | SAI | EFF | BRI | BRD | TOG |     |      |   |
            //|      | RST | BOOT| UNLK|     |     |     |     |     |     |      |   |
            //                        |     |     |     |     |     |     |

            bindings = <
&trans  &bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none  &none  &none  &none  &trans  &trans  &rgb_ug RGB_HUD  &rgb_ug RGB_HUI  &rgb_ug RGB_SAD  &rgb_ug RGB_SAI  &rgb_ug RGB_EFF  &rgb_ug RGB_BRI  &rgb_ug RGB_BRD  &rgb_ug RGB_TOG  &none  &none  &trans  &trans  &sys_reset  &bootloader  &studio_unlock  &none  &none  &none  &none  &none  &none  &none  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        shortcut_layer {
            display-name = "shortcut";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp LS(LG(NUMBER_4))  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
